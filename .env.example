# Groq API Key for Llama 3.1
# Get your free key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Example:
# GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# PostgreSQL connection (document/chunk metadata + conversation memory).
# Stores metadata only — embeddings stay in ChromaDB. The app creates the
# database and tables on startup if they don't exist.
# Using the psycopg (v3) driver:
DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/ai_document_analyst

# --- Optional configuration (defaults shown; uncomment to override) ---
# Where the local ChromaDB vector store is persisted.
# CHROMA_PERSIST_DIR=chroma_db
# Name of the Chroma collection that holds all document chunks.
# CHROMA_COLLECTION_NAME=document_chunks
# Maximum upload size per file, in megabytes.
# MAX_UPLOAD_SIZE_MB=25
# How many chunks to retrieve from the vector store per question.
# TOP_K=5
# Maximum chunks actually sent to the LLM as evidence (<= TOP_K).
# MAX_CONTEXT_CHUNKS=4